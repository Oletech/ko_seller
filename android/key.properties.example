# Copy to android/key.properties and fill in. Gitignored.
# Generate the upload keystore once, and back it up somewhere safe:
#
#   keytool -genkey -v -keystore ~/kariakoonline-seller-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storeFile=/absolute/path/to/kariakoonline-seller-upload.jks
storePassword=
keyAlias=upload
keyPassword=
